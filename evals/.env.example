# Settings for evals/run-evals.sh. Copy this file to evals/.env to change a value.
# The script also reads ../scripts/.env when it exists (MASTER_HOST, HDFS_PORT, SPARK_VERSION, HADOOP_USER_HOME).
# A variable set in your shell wins over every file.

# --- Cluster ---
MASTER_HOST=pi1                          # master node: NameNode, ResourceManager, History Server
HDFS_PORT=9000                           # HDFS is at hdfs://MASTER_HOST:HDFS_PORT
HADOOP_USER_HOME=/home/hadoop
#SPARK_HOME=/home/hadoop/spark-4.3.0     # default: HADOOP_USER_HOME/spark-SPARK_VERSION
#HADOOP_HOME=/home/hadoop/hadoop-3.5.0   # default: HADOOP_USER_HOME/hadoop-HADOOP_VERSION
RM_PORT=8088                             # YARN web UI
HISTORY_PORT=18080                       # Spark History Server web UI

# --- Where the data goes in HDFS ---
HDFS_BASE=/evals                         # input:  /evals/<domain>/*.csv
HDFS_OUT=/evals-out                      # output: /evals-out/<domain>/<language>/<result>/

# --- How the jobs run (YARN gives 1536 MB per node, so keep these small) ---
QUEUE=dev                                # dev (30%) or prod (70%)
DEPLOY_MODE=client                       # client or cluster
EXECUTORS=2
EXECUTOR_CORES=1
EXECUTOR_MEMORY=512m
DRIVER_MEMORY=512m
MEMORY_OVERHEAD=256m                     # container = memory + overhead, must stay at or below 1536 MB
SPLIT_BYTES=524288                       # 512 KiB per input split: a 3 MB file gives about 6 tasks
SHUFFLE_PARTITIONS=8
JOB_TIMEOUT=3600                         # seconds before one job is stopped
