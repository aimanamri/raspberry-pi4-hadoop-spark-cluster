# Settings for the cluster scripts.
# Copy this file to `.env` in the same folder, then change the values.
#   cp scripts/.env.example scripts/.env
# If `.env` does not exist, the scripts use the values in this file.
# Use plain KEY=value lines. Do not put spaces around the = sign.

# ---------------------------------------------------------------- nodes
# Each node is name=ip, separated by spaces. Use the same list on every Pi.
NODES="pi1=192.168.35.11 pi2=192.168.35.12 pi3=192.168.35.13"
# The master node. It must be one of the names in NODES.
# All other nodes are workers.
MASTER_HOST=pi1

# ---------------------------------------------------------------- user
# The Linux user that runs Hadoop and Spark. The scripts create it.
HADOOP_USER=hadoop

# ---------------------------------------------------------------- versions
HADOOP_VERSION=3.5.0
SPARK_VERSION=4.3.0
# Hadoop 3.5.0 needs Java 17 for the daemons.
JAVA_VERSION=17
# auto   : use apt if the OS has the package, if not use SDKMAN
# apt    : use apt only (Raspberry Pi OS Bookworm, Ubuntu 22.04 and 24.04)
# sdkman : use SDKMAN only (Raspberry Pi OS Trixie)
JAVA_METHOD=auto
# Only for SDKMAN. Leave empty to pick the newest Temurin build of JAVA_VERSION.
# Example: 17.0.13-tem
SDKMAN_JAVA_IDENTIFIER=

# ---------------------------------------------------------------- downloads
# The scripts try the first address. If the file is not there, they try the archive.
HADOOP_DOWNLOAD_BASE=https://dlcdn.apache.org/hadoop/common
HADOOP_ARCHIVE_BASE=https://archive.apache.org/dist/hadoop/common
SPARK_DOWNLOAD_BASE=https://dlcdn.apache.org/spark
SPARK_ARCHIVE_BASE=https://archive.apache.org/dist/spark

# ---------------------------------------------------------------- HDFS
# Number of copies of each data block. Do not set it higher than the number of workers.
HDFS_REPLICATION=1
# NameNode port (the address is hdfs://MASTER_HOST:HDFS_PORT).
HDFS_PORT=9000
# Folder for the HDFS data. The scripts create namenode and datanode folders inside it.
HDFS_DATA_DIR=/home/hadoop/hdfs

# ---------------------------------------------------------------- YARN memory (MB)
YARN_NODE_MEMORY_MB=1536
YARN_MAX_ALLOCATION_MB=1536
YARN_MIN_ALLOCATION_MB=128
MAPRED_AM_MEMORY_MB=512
MAPRED_MAP_MEMORY_MB=256
MAPRED_REDUCE_MEMORY_MB=256

# ---------------------------------------------------------------- Spark
SPARK_DRIVER_MEMORY=512m
SPARK_AM_MEMORY=512m
SPARK_EXECUTOR_MEMORY=512m
# Spark History Server port
SPARK_HISTORY_PORT=18080
# Spark event log folder in HDFS
SPARK_LOG_DIR_HDFS=/spark-logs
# YARN queue that the verify script uses
VERIFY_QUEUE=dev

# ---------------------------------------------------------------- setup-node.sh
# Set to 1 to skip "apt upgrade" (apt update still runs).
SKIP_UPGRADE=0
